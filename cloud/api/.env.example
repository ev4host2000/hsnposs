APP_ENV=development
APP_DEBUG=true
APP_URL=http://127.0.0.1:8787
APP_TIMEZONE=UTC

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mizacloud
DB_USER=mizacloud
DB_PASSWORD=

JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

LOG_LEVEL=debug
LOG_PATH=storage/logs

# CORS — comma-separated origins, or * for development
CORS_ALLOWED_ORIGINS=*
CORS_ALLOW_CREDENTIALS=false

# Rate limiting on /auth/login (B16)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW=60

# Platform ops admin (Admin Panel at /admin/)
OPS_ADMIN_EMAIL=info@mizapos.com
OPS_ADMIN_PASSWORD_HASH=
OPS_ADMIN_ACCESS_TTL=3600
